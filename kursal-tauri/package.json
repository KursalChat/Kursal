{
  "name": "kursal-app",
  "version": "0.1.0-beta.11",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "lsof -i :1420 > /dev/null 2>&1 || bunx --bun vite dev --host 0.0.0.0",
    "dev:mock": "VITE_MOCK=1 bunx --bun vite dev --port 1430",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt \"src/**/*.{ts,svelte}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,svelte}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-sharekit-api": "^0.4.0-rc.7",
    "@tauri-apps/api": "^2.12.3",
    "@tauri-apps/plugin-autostart": "~2.7.0",
    "@tauri-apps/plugin-barcode-scanner": "~2.5.2",
    "@tauri-apps/plugin-biometric": "~2.4.2",
    "@tauri-apps/plugin-clipboard-manager": "~2.4.2",
    "@tauri-apps/plugin-deep-link": "~2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.2",
    "@tauri-apps/plugin-fs": "^2.7.0",
    "@tauri-apps/plugin-haptics": "~2.4.2",
    "@tauri-apps/plugin-notification": "~2.6.0",
    "@tauri-apps/plugin-opener": "~2.7.1",
    "@tauri-apps/plugin-os": "~2.4.0",
    "@tauri-apps/plugin-updater": "~2.13.3",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.1.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "emojibase-data": "^17.0.0",
    "jsdom": "^30.1.2",
    "oxfmt": "^0.72.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
