{
  "name": "kursal-app",
  "version": "0.1.0-beta.9",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "lsof -i :1420 > /dev/null 2>&1 || bunx --bun vite dev --host 0.0.0.0",
    "build": "bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "oxfmt \"src/**/*.{ts,svelte}\"",
    "format:check": "oxfmt --check \"src/**/*.{ts,svelte}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri"
  },
  "dependencies": {
    "@choochmeque/tauri-plugin-sharekit-api": "^0.4.0-rc.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-barcode-scanner": "~2.4.5",
    "@tauri-apps/plugin-biometric": "~2.3.2",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-deep-link": "~2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-haptics": "~2.3.2",
    "@tauri-apps/plugin-notification": "~2.3.3",
    "@tauri-apps/plugin-opener": "~2.5.4",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "dompurify": "^3.4.14",
    "highlight.js": "^11.12.0",
    "lucide-svelte": "^1.0.1",
    "marked": "^18.0.11",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.3.0",
    "emojibase-data": "^17.0.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.65.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
