#!/bin/bash
set -e

ZERO="0000000000000000000000000000000000000000"

strict_flag=
branch=
changed=
run_all=0

while read -r _local_ref local_sha remote_ref remote_sha; do
  branch="$remote_ref"
  [ "$remote_ref" = "refs/heads/main" ] && strict_flag="--strict"

  # branch deletion: nothing to check
  [ "$local_sha" = "$ZERO" ] && continue

  # new branch on the remote: no base to diff against, so check everything
  if [ "$remote_sha" = "$ZERO" ]; then
    run_all=1
  else
    changed="$changed$(git diff --name-only "$remote_sha" "$local_sha")
"
  fi
done

[ -z "$branch" ] && exit 0

if [ "$branch" = "refs/heads/dev" ]; then
  echo "▶ pre-push (dev): skipping checks"
  exit 0
fi

run_rust=$run_all
run_frontend=$run_all

if [ "$run_all" -eq 0 ]; then
  if printf '%s' "$changed" | grep -qE '^(kursal-core|kursal-cli|kursal-tauri/src-tauri|externals)/|^Cargo\.(toml|lock)$|^justfile$'; then
    run_rust=1
  fi
  if printf '%s' "$changed" | grep -E '^kursal-tauri/' | grep -qv '^kursal-tauri/src-tauri/'; then
    run_frontend=1
  fi
  if printf '%s' "$changed" | grep -qE '^locales/|^bin/checkTranslations\.ts$|^justfile$'; then
    run_frontend=1
  fi
fi

if [ "$run_rust" -eq 0 ] && [ "$run_frontend" -eq 0 ]; then
  echo "▶ pre-push: no rust or frontend changes, skipping checks"
  exit 0
fi

just format

if [ "$run_rust" -eq 1 ]; then
  echo "▶ pre-push: just check-rust…"
  just check-rust
fi

if [ "$run_frontend" -eq 1 ]; then
  if [ -n "$strict_flag" ]; then
    echo "▶ pre-push (main): just check-frontend - strict translations…"
  else
    echo "▶ pre-push: just check-frontend - translations warn-only (strict on main)…"
  fi
  just check-frontend "$strict_flag"
fi

echo "✓ pre-push checks passed"
